# Configuracao de PROCESSO do gateway — o que muda de maquina para maquina.
#
# O que NAO esta aqui e tao importante quanto o que esta: o significado do dado —
# pontos de medicao, unidades, orcamentos de admissao — vive em
# configuracao/instalacao.yaml, que e versionado e revisavel. Este arquivo carrega
# apenas enderecos e caminhos.
#
# Instalar em /etc/synkacore/gateway.env

# Lado de CHAO DE FABRICA. Onde as origens entregam.
SYNKACORE_INGRESSO=0.0.0.0:8443

# Lado de ESCRITORIO. Somente leitura: saude, leituras, contrato, comissionamento.
#
# Interfaces SEPARADAS de proposito. O gateway e endpoint nas duas redes e nunca
# ponte de trafego; publicar as duas na mesma interface destruiria a separacao que
# faz o caminho de aquisicao nao ficar exposto ao escritorio.
SYNKACORE_APRESENTACAO=0.0.0.0:8080

# O diario de ingestao — o registro AUTORITATIVO.
#
# Precisa estar em disco persistente e local. Nunca em tmpfs (o fsync nao alcancaria
# midia e a durabilidade seria ficcao) e nunca em rede (uma queda de NFS viraria uma
# queda de aquisicao).
SYNKACORE_DIARIO=/var/lib/synkacore/synkacore.db

# Banco de consulta. VAZIO desliga a projecao, e o gateway opera completo assim: a
# aquisicao nao depende dele, so os graficos.
SYNKACORE_BANCO=

# Configuracao da instalacao. Vazio faz o gateway gravar canais sem significado, que
# e o estado normal ANTES do comissionamento.
SYNKACORE_INSTALACAO=/etc/synkacore/instalacao.yaml

SYNKACORE_REGISTRO=info
